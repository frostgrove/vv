#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)
GO=${GO:-go}
cd "$REPO_ROOT"

usage() {
	cat <<'EOF'
Usage: make <command>

  unit                         Run unit tests in every module
  integration, test            Run integration tests, or both suites
  examples                     Build, vet and test runnable examples
  up, down, logs               Manage local databases
  psql, mysql, mariadb         Open a database shell
  fmt, vet, tidy               Format, vet or tidy the repository
  generate, ent, corpus        Regenerate code or the SQL error corpus
  check                        Run all structural checks
  check-deps, check-tiers      Run an individual dependency check
  check-utils, check-triplets
  check-todo, check-replaces
  check-tidy, check-otel-schema, check-otel-module, check-otel-live, check-otel-native-budget, check-otel-operations, check-workspace, check-otel-consumer, check-i18n-consumer
  check-otel-wire, check-otel-collector, check-otel-prometheus, check-otel-weaver
  check-event-kernel           Compare event/ outside event/eventpg with its manifest
  check-event-kernel-baseline  Record that manifest, in the same change as the code
  check-event-kernel-moved     Read what a re-baseline moved: <predecessor> <allowed> [required...]
  api, vuln                    Regenerate API baseline or scan vulnerabilities
  main-deps, version, release  Maintain module versions and publish a release
  clean                        Stop databases and clear Go's test cache
EOF
}

database() {
	"$SCRIPT_DIR/database.sh" "$1"
}

case ${1:-help} in
	help) usage ;;
	unit|vet|examples|tidy|main-deps|generate|ent|api|vuln|version)
		exec "$SCRIPT_DIR/modules.sh" "$1"
		;;
	check) exec "$SCRIPT_DIR/checks.sh" all ;;
	check-deps) exec "$SCRIPT_DIR/checks.sh" deps ;;
	check-tiers) exec "$SCRIPT_DIR/checks.sh" tiers ;;
	check-utils) exec "$SCRIPT_DIR/checks.sh" utils ;;
	check-triplets) exec "$SCRIPT_DIR/checks.sh" triplets ;;
	check-todo) exec "$SCRIPT_DIR/checks.sh" todo ;;
	check-replaces) exec "$SCRIPT_DIR/checks.sh" replaces ;;
	check-tidy) exec "$SCRIPT_DIR/checks.sh" tidy ;;
	check-otel-schema) exec "$SCRIPT_DIR/checks.sh" otel-schema ;;
	check-otel-module) exec "$SCRIPT_DIR/checks.sh" otel-module ;;
	check-otel-live)
		cd test
		echo 'check-otel-live: real SDK and in-process OTLP proof'
		exec env GOWORK=off "$GO" test -race -count=1 ./oteltelemetry
		;;
	check-otel-native-budget)
		cd test
		echo 'check-otel-native-budget: pinned native metric identities and series ceilings'
		exec env -u OTEL_SEMCONV_STABILITY_OPT_IN GOWORK=off "$GO" test -race -count=1 ./otelnative -run '^TestNativeBudget'
		;;
	check-otel-operations) exec "$SCRIPT_DIR/otel-operations.sh" offline ;;
	check-otel-wire) exec "$SCRIPT_DIR/otel-operations.sh" wire ;;
	check-otel-collector) exec "$SCRIPT_DIR/otel-operations.sh" collector ;;
	check-otel-prometheus) exec "$SCRIPT_DIR/otel-operations.sh" prometheus ;;
	check-otel-weaver) exec "$SCRIPT_DIR/otel-operations.sh" weaver ;;
	check-workspace) exec "$SCRIPT_DIR/checks.sh" workspace ;;
	check-event-kernel) exec "$SCRIPT_DIR/checks.sh" event-kernel ;;
	check-event-kernel-baseline) exec "$SCRIPT_DIR/checks.sh" event-kernel-baseline ;;
	check-event-kernel-moved) shift; exec "$SCRIPT_DIR/checks.sh" event-kernel-moved "$@" ;;
	check-otel-consumer) exec "$SCRIPT_DIR/otel-consumer.sh" ;;
	check-i18n-consumer) exec "$SCRIPT_DIR/i18n-consumer.sh" ;;
	up|down|logs|psql|mysql|mariadb) exec "$SCRIPT_DIR/database.sh" "$1" ;;
	fmt) exec gofmt -l -w . ;;
	integration)
		database up
		exec "$GO" test -race -tags=integration -count=1 ./test/...
		;;
	test)
		"$SCRIPT_DIR/modules.sh" unit
		database up
		exec "$GO" test -race -tags=integration -count=1 ./test/...
		;;
	corpus)
		database up
		(cd test && exec "$GO" run ./cmd/corpus)
		;;
	release)
		"$0" test
		"$SCRIPT_DIR/checks.sh" all
		"$SCRIPT_DIR/modules.sh" vuln
		exec "$SCRIPT_DIR/release.sh"
		;;
	clean)
		database down
		exec "$GO" clean -testcache
		;;
	*) echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
