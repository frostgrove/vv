{
  "version": 1,
  "semconv_mode": {
    "environment": "OTEL_SEMCONV_STABILITY_OPT_IN",
    "unset": true
  },
  "domains": {
    "http_methods": {
      "type": "string",
      "string_values": ["CONNECT", "DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT", "TRACE", "_OTHER"]
    },
    "http_status_codes": {
      "type": "int64",
      "int64_range": {"minimum": 100, "maximum": 599}
    },
    "servemux_route_projections": {
      "type": "string",
      "string_values": ["/items/{id}", "/live"]
    },
    "http_management": {
      "type": "string",
      "string_values": ["false", "true"]
    },
    "router_route_templates": {
      "type": "string",
      "string_values": ["/items/:id", "/fail/:id"]
    },
    "grpc_system": {
      "type": "string",
      "string_values": ["grpc"]
    },
    "rpc_methods": {
      "type": "string",
      "string_values": ["otelnative.Transport/Ping", "otelnative.Transport/Fail", "_OTHER/_OTHER"]
    },
    "grpc_status_codes": {
      "type": "string",
      "string_values": ["OK", "CANCELLED", "UNKNOWN", "INVALID_ARGUMENT", "DEADLINE_EXCEEDED", "NOT_FOUND", "ALREADY_EXISTS", "PERMISSION_DENIED", "RESOURCE_EXHAUSTED", "FAILED_PRECONDITION", "ABORTED", "OUT_OF_RANGE", "UNIMPLEMENTED", "INTERNAL", "UNAVAILABLE", "DATA_LOSS", "UNAUTHENTICATED"]
    },
    "postgres_system": {
      "type": "string",
      "string_values": ["postgresql"]
    },
    "pgx_operations": {
      "type": "string",
      "string_values": ["query", "copy", "batch", "connect", "prepare", "acquire"]
    },
    "sql_operations": {
      "type": "string",
      "string_values": ["sql.connector.connect", "sql.conn.ping", "sql.conn.exec", "sql.conn.query", "sql.conn.prepare", "sql.conn.begin_tx", "sql.conn.reset_session", "sql.tx.commit", "sql.tx.rollback", "sql.stmt.exec", "sql.stmt.query", "sql.rows"]
    },
    "database_pools": {
      "type": "string",
      "string_values": ["primary"]
    },
    "sql_pool_status": {
      "type": "string",
      "string_values": ["inuse", "idle"]
    },
    "runtime_memory_types": {
      "type": "string",
      "string_values": ["other", "stack"]
    }
  },
  "resources": [
    {"id": "transport", "schema_url": "", "attributes": {"service.name": "transport-fixture"}},
    {"id": "database", "schema_url": "", "attributes": {"service.name": "database-fixture"}},
    {"id": "runtime", "schema_url": "", "attributes": {"service.name": "runtime-fixture"}}
