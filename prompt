Ключевая идея, из которой всё вытекает: через границу абстракции должно проходить только «выполни запрос» и «дай строки». Сканирование остаётся у маппера, диалект — у репозитория, а не у исполнителя. Именно поэтому в контекст можно втолкнуть чужую транзакцию — от неё требуется всего два метода, она ничего не знает про твои SQL-соглашения.

Ядро (crud) — ноль зависимостей
go
package crud

type Rows interface {
	Next() bool
	Scan(dest ...any) error
	Err() error
	Close()
}

// Всё, что нужно от чужой транзакции.
type Executor interface {
	Exec(ctx context.Context, q string, args ...any) (int64, error)
	Query(ctx context.Context, q string, args ...any) (Rows, error)
}

// Опционально: умеет начинать свои транзакции.
type Beginner interface {
	Begin(ctx context.Context) (Tx, error)
}

type Tx interface {
	Executor
	Commit(ctx context.Context) error
	Rollback(ctx context.Context) error
}

// То, что отдаёт адаптер при инициализации.
type Source interface {
	Executor
	Dialect() Dialect
}

type Dialect interface {
	Placeholder(n int) string
	Quote(ident string) string
	OnConflict(pk string, cols []string) string
}

Rows подобран так, что pgx.Rows удовлетворяет ему напрямую — Close() там уже void. Обёртка нужна только для *sql.Rows.

