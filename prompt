Репозиторий
go
type Repository[M any, ID comparable] struct {
	db  Executor
	m   Mapper[M, ID]
	get, save, del string
}

func New[M any, ID comparable](src Source, m Mapper[M, ID]) *Repository[M, ID] {
	d, cols := src.Dialect(), m.Columns()
	pk, tbl := cols[0], d.Quote(m.Table())

	qc := make([]string, len(cols))
	ph := make([]string, len(cols))
	for i, c := range cols {
		qc[i] = d.Quote(c)
		ph[i] = d.Placeholder(i + 1)
	}
	list, vals := strings.Join(qc, ", "), strings.Join(ph, ", ")
	where := " WHERE " + d.Quote(pk) + " = " + d.Placeholder(1)

	return &Repository[M, ID]{
		db:   src,
		m:    m,
		get:  "SELECT " + list + " FROM " + tbl + where,
		save: "INSERT INTO " + tbl + " (" + list + ") VALUES (" + vals + ")" + d.OnConflict(pk, cols[1:]),
		del:  "DELETE FROM " + tbl + where,
	}
}

func (r *Repository[M, ID]) exec(ctx context.Context) Executor {
	if e, ok := fromCtx(ctx); ok {
		return e
	}
	return r.db
}

func (r *Repository[M, ID]) Get(ctx context.Context, id ID) (M, error) {
	var m M
	rows, err := r.exec(ctx).Query(ctx, r.get, id)
	if err != nil {
		return m, err
	}
	defer rows.Close()

	if !rows.Next() {
		if err := rows.Err(); err != nil {
			return m, err
		}
		return m, ErrNotFound
	}
	if err := rows.Scan(r.m.Fields(&m)...); err != nil {
		return m, err
	}
	return m, rows.Err()
}

func (r *Repository[M, ID]) Save(ctx context.Context, m *M) error {
	_, err := r.exec(ctx).Exec(ctx, r.save, r.m.Fields(m)...)
	return err
}

func (r *Repository[M, ID]) Delete(ctx context.Context, id ID) error {
	n, err := r.exec(ctx).Exec(ctx, r.del, id)
	if err != nil {
		return err
	}
	if n == 0 {
		return ErrNotFound
	}
	return nil
}

// Своя транзакция — но если в контексте уже чужая, просто присоединяемся.
func (r *Repository[M, ID]) InTx(ctx context.Context, fn func(context.Context) error) error {
	if _, ok := fromCtx(ctx); ok {
		return fn(ctx)
	}
	b, ok := r.db.(Beginner)
	if !ok {
		return ErrNoTxSupport
	}
	tx, err := b.Begin(ctx)
	if err != nil {
		return err
	}
	if err := fn(WithExecutor(ctx, tx)); err != nil {
		_ = tx.Rollback(ctx)
		return err
	}
	return tx.Commit(ctx)
}

SQL строится один раз при создании, в горячем пути — ни конкатенации, ни рефлексии.

Адаптер database/sql

Один адаптер закрывает ent, gorm, sqlx, bun, sqlc-на-database/sql и голый *sql.DB.

go
package crudsql

type queryer interface {
	ExecContext(ctx context.Context, q string, args ...any) (sql.Result, error)
	QueryContext(ctx context.Context, q string, args ...any) (*sql.Rows, error)
}

type Exec struct{ q queryer }

func From(q queryer) Exec { return Exec{q} }

func (e Exec) Exec(ctx context.Context, q string, args ...any) (int64, error) {
	res, err := e.q.ExecContext(ctx, q, args...)
	if err != nil {
		return 0, err
	}
	return res.RowsAffected()
}

func (e Exec) Query(ctx context.Context, q string, args ...any) (crud.Rows, error) {
	rs, err := e.q.QueryContext(ctx, q, args...)
	if err != nil {
		return nil, err
	}
	return rows{rs}, nil
}

type rows struct{ *sql.Rows }

func (r rows) Close() { _ = r.Rows.Close() } // гасим error, внешний метод перекрывает встроенный

// Полноценный Source поверх *sql.DB
type DB struct {
	Exec
	db *sql.DB
	d  crud.Dialect
}

func Open(db *sql.DB, d crud.Dialect) DB { return DB{Exec{db}, db, d} }

func (d DB) Dialect() crud.Dialect { return d.d }

func (d DB) Begin(ctx context.Context) (crud.Tx, error) {
	tx, err := d.db.BeginTx(ctx, nil)
	if err != nil {
		return nil, err
	}
	return sqlTx{Exec{tx}, tx}, nil
}
Адаптер pgx
go
package crudpgx

type pool interface {
	Exec(context.Context, string, ...any) (pgconn.CommandTag, error)
	Query(context.Context, string, ...any) (pgx.Rows, error)
}

type Exec struct{ p pool }

func From(p pool) Exec { return Exec{p} } // *pgxpool.Pool, *pgx.Conn, pgx.Tx

func (e Exec) Exec(ctx context.Context, q string, args ...any) (int64, error) {
	tag, err := e.p.Exec(ctx, q, args...)
	return tag.RowsAffected(), err
}

func (e Exec) Query(ctx context.Context, q string, args ...any) (crud.Rows, error) {
	return e.p.Query(ctx, q, args...) // pgx.Rows уже подходит
}

Вложенный Begin у pgx автоматически даёт SAVEPOINT — вложенные транзакции работают бесплатно.

Как это выглядит у пользователей

Голый pgx — библиотека владеет транзакцией:

go
src := crudpgx.Open(pool)
users := crud.New(src, UserMapper{})

users.InTx(ctx, func(ctx context.Context) error {
	u, err := users.Get(ctx, 42)
	if err != nil { return err }
	u.Name = "new"
	return users.Save(ctx, &u)
})

ent (с --feature sql/execquery) — транзакцией владеет ent:

go
users := crud.New(crudsql.Open(db, crud.Postgres{}), UserMapper{})

ent.WithTx(ctx, client, func(tx *ent.Tx) error {
	ctx := crud.WithExecutor(ctx, crudsql.From(tx))

	if err := users.Save(ctx, &u); err != nil { return err }
	_, err := tx.Order.Create().SetUserID(u.ID).Save(ctx)
	return err
})

Одна физическая транзакция на обоих — *ent.Tx с фичефлагом отдаёт тот же *sql.Tx, что лежит под ним.

gorm — то же самое через Statement.ConnPool:

go
db.Transaction(func(tx *gorm.DB) error {
	ctx := crud.WithExecutor(ctx, crudsql.From(tx.Statement.ConnPool))
	return users.Save(ctx, &u)
})

Внутри Transaction gorm подменяет ConnPool на *sql.Tx, интерфейс ConnPool уже содержит нужные ExecContext/QueryContext.

sqlc — оба варианта генерации:

go
// database/sql
tx, _ := db.BeginTx(ctx, nil)
q := gen.New(tx)
ctx = crud.WithExecutor(ctx, crudsql.From(tx))

// pgx
tx, _ := pool.Begin(ctx)
q := gen.New(tx)
ctx = crud.WithExecutor(ctx, crudpgx.From(tx))

pgx.Tx удовлетворяет и sqlc.DBTX, и твоему pool — передаёшь один объект в оба места.

sqlx / bun / squirrel — crudsql.From(tx), там везде обычный *sql.Tx.

Точка интеропа ровно одна: WithExecutor. Новый фреймворк = найти, где он прячет свою транзакцию, и обернуть. Три строки.

Bulk без компромиссов

Быстрый путь протаскивается опциональным интерфейсом, ядро о pgx по-прежнему не знает:

go
type BulkInserter interface {
	CopyFrom(ctx context.Context, table string, cols []string, rows [][]any) (int64, error)
}

func (r *Repository[M, ID]) SaveAll(ctx context.Context, ms []M) error {
	if b, ok := r.exec(ctx).(BulkInserter); ok {
		return b.CopyFrom(ctx, r.m.Table(), r.m.Columns(), r.values(ms))
	}
	return r.multiRowInsert(ctx, ms) // фолбэк
}

crudpgx.Exec его реализует нативно. Для crudsql — через conn.Raw (только на *sql.Conn, не на *sql.Tx).

Острые углы, о которых лучше знать заранее

RowsAffected расходится. У pgx UPDATE, который ничего не изменил, вернёт 0; у некоторых драйверов database/sql — тоже 0, но MySQL по умолчанию считает «затронутые», а не «изменённые». Не завязывай ErrNotFound на n == 0 в Save, только в Delete.

Вложенные транзакции. pgx даёт SAVEPOINT сам, database/sql — нет. Если нужны, придётся выдавать SAVEPOINT sp_n руками в sqlTx.Begin.

Чужой executor и InTx. Я сделал «присоединиться», а не «вложить». Это значит, что fn не может откатиться независимо от внешней транзакции. Для библиотеки поведение правильное, но задокументируй явно — иначе кто-нибудь ожидает изоляции.

gorm вне транзакции. db.Statement.ConnPool там *sql.DB — работает, но если пользователь передаст *gorm.DB из чейна с WithContext, Statement может быть переиспользован. Безопаснее принимать tx *gorm.DB только внутри Transaction.

